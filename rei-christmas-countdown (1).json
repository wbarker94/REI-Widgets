{
  "name": "REI Co-op Countdown to Christmas",
  "type": "html",
  "minWidth": 220,
  "maxWidth": 900,
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>REI Co-op · Countdown to Christmas</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bitter:wght@500;700;800&family=Work+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --night:#10241C;      /* spruce night sky */\n    --pine:#2B5640;       /* forest ridge */\n    --ridge:#1A3529;      /* far ridge */\n    --snow:#FFFFFF;\n    --frost:#CFE1E6;      /* muted text */\n    --ember:#D2232A;      /* holiday red */\n    --lantern:#F0B64A;    /* warm gold */\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html,body{background:var(--night);height:100%}\n  :root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n  html{scroll-padding-top:env(safe-area-inset-top,0px)}\n  body{font-family:\"Work Sans\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;color:var(--snow)}\n\n  .widget{\n    container-type:inline-size;\n    position:relative;\n    width:100%;\n    min-width:220px;\n    max-width:900px;\n    margin:0 auto;\n    overflow:hidden;\n    border-radius:14px;\n    background:\n      radial-gradient(120% 80% at 80% 0%, #1E4034 0%, transparent 60%),\n      linear-gradient(180deg, var(--night) 0%, #16302A 100%);\n    isolation:isolate;\n  }\n  canvas.snow{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}\n\n  .inner{position:relative;z-index:2;padding:clamp(14px,4cqi,32px) clamp(14px,4.5cqi,36px) 0}\n\n  /* Header */\n  .top{display:flex;align-items:center;justify-content:space-between;gap:12px}\n  .badge{background:var(--snow);border-radius:8px;padding:clamp(4px,1cqi,8px) clamp(6px,1.4cqi,10px);display:inline-flex;line-height:0}\n  .logo{height:clamp(26px,6cqi,42px);width:auto;display:block}\n  .greet{font-family:\"Bitter\",Georgia,serif;font-weight:500;font-size:clamp(12px,2.2cqi,16px);color:var(--frost);text-align:right;line-height:1.3}\n\n  h1{\n    font-family:\"Bitter\",Georgia,serif;font-weight:800;\n    font-size:clamp(20px,5.4cqi,40px);line-height:1.1;letter-spacing:-.01em;\n    margin-top:clamp(12px,3cqi,22px);\n  }\n  .sub{color:var(--frost);font-size:clamp(12px,2cqi,15px);margin-top:4px}\n\n  /* Countdown */\n  .clock{\n    display:grid;grid-template-columns:repeat(4,1fr);\n    gap:clamp(6px,1.6cqi,14px);\n    margin-top:clamp(14px,3.4cqi,26px);\n  }\n  .unit{\n    background:rgba(255,255,255,.06);\n    border:1px solid rgba(255,255,255,.12);\n    border-radius:10px;\n    padding:clamp(8px,2cqi,16px) 4px clamp(6px,1.4cqi,12px);\n    text-align:center;\n  }\n  .unit.days{background:var(--ember);border-color:var(--ember)}\n  .num{\n    font-family:\"Bitter\",Georgia,serif;font-weight:700;\n    font-size:clamp(26px,9cqi,72px);line-height:1;\n    font-variant-numeric:tabular-nums;\n  }\n  .lbl{font-size:clamp(11px,1.8cqi,14px);color:var(--frost);margin-top:4px}\n  .unit.days .lbl{color:#FFE3E3}\n\n  /* Trail to the summit */\n  .trail{position:relative;margin-top:clamp(16px,3.6cqi,28px)}\n  .trail svg{display:block;width:100%;height:auto}\n  .trail-meta{\n    display:flex;justify-content:space-between;align-items:baseline;gap:8px;\n    font-size:clamp(11px,1.8cqi,14px);color:var(--frost);\n    background:var(--pine);\n    padding:clamp(6px,1.4cqi,10px) clamp(14px,4.5cqi,36px) clamp(10px,2cqi,16px);\n    margin-top:-1px;\n  }\n  .trail-meta strong{color:var(--lantern);font-weight:600}\n\n  /* Christmas Day state */\n  .merry{display:none;text-align:center;padding:clamp(10px,3cqi,20px) 0}\n  .merry .big{font-family:\"Bitter\",Georgia,serif;font-weight:800;font-size:clamp(28px,8cqi,64px);color:var(--lantern);line-height:1.05}\n  .merry p{color:var(--frost);margin-top:6px;font-size:clamp(12px,2.2cqi,16px)}\n  .widget.is-christmas .clock{display:none}\n  .widget.is-christmas .merry{display:block}\n\n  /* Narrow widths: 2 x 2 grid, stacked header */\n  @container (max-width:380px){\n    .clock{grid-template-columns:repeat(3,1fr)}\n    .unit.days{grid-column:1 / -1}\n    .num{font-size:28px}\n    .unit.days .num{font-size:52px}\n    .greet{display:none}\n    .trail-meta{flex-direction:column;align-items:flex-start;gap:0}\n  }\n  @media (prefers-reduced-motion:reduce){ canvas.snow{display:none} .hiker{transition:none} }\n</style>\n</head>\n<body>\n<section class=\"widget\" id=\"xmas\" aria-labelledby=\"xmas-title\">\n  <canvas class=\"snow\" aria-hidden=\"true\"></canvas>\n\n  <div class=\"inner\">\n    <div class=\"top\">\n      <span class=\"badge\"><img class=\"logo\" alt=\"REI Co-op\" src=\"data:image/png;base64,\"></span>\n      <p class=\"greet\">Happy holidays<br>from your co-op</p>\n    </div>\n\n    <h1 id=\"xmas-title\">Countdown to Christmas</h1>\n    <p class=\"sub\" id=\"sub\">Until December 25</p>\n\n    <div class=\"clock\" role=\"timer\" aria-live=\"off\">\n      <div class=\"unit days\"><div class=\"num\" id=\"d\">--</div><div class=\"lbl\">days</div></div>\n      <div class=\"unit\"><div class=\"num\" id=\"h\">--</div><div class=\"lbl\">hours</div></div>\n      <div class=\"unit\"><div class=\"num\" id=\"m\">--</div><div class=\"lbl\">minutes</div></div>\n      <div class=\"unit\"><div class=\"num\" id=\"s\">--</div><div class=\"lbl\">seconds</div></div>\n    </div>\n\n    <div class=\"merry\">\n      <div class=\"big\">Merry Christmas</div>\n      <p>Thanks for all you do this season. Now go enjoy some time outside.</p>\n    </div>\n  </div>\n\n  <!-- Ridgeline: the season is a climb, Christmas is the summit -->\n  <div class=\"trail\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 900 170\" preserveAspectRatio=\"none\">\n      <path fill=\"var(--ridge)\" d=\"M0 110 L90 70 L150 95 L240 40 L320 85 L410 55 L500 92 L600 48 L690 80 L780 60 L900 90 L900 170 L0 170Z\"/>\n      <path id=\"ridge\" fill=\"var(--pine)\" d=\"M0 150 L120 128 L210 136 L330 104 L420 116 L540 80 L620 92 L740 46 L800 58 L860 30 L900 44 L900 170 L0 170Z\"/>\n      <!-- snowcap on summit -->\n      <path fill=\"var(--snow)\" opacity=\".9\" d=\"M845 38 L860 30 L878 39 L868 42 L860 37 L852 43Z\"/>\n      <!-- trees -->\n      <g fill=\"#0F2219\">\n        <path d=\"M60 152 l10 -26 l10 26z\"/><path d=\"M78 152 l8 -20 l8 20z\"/>\n        <path d=\"M250 140 l11 -28 l11 28z\"/><path d=\"M270 138 l8 -20 l8 20z\"/>\n        <path d=\"M470 118 l10 -26 l10 26z\"/><path d=\"M660 98 l9 -24 l9 24z\"/>\n      </g>\n      <!-- trail line (invisible guide) -->\n      <path id=\"path\" fill=\"none\" stroke=\"rgba(255,255,255,.35)\" stroke-width=\"2\" stroke-dasharray=\"2 7\"\n        d=\"M20 146 L120 128 L210 136 L330 104 L420 116 L540 80 L620 92 L740 46 L800 58 L860 30\"/>\n      <!-- summit star -->\n      <g transform=\"translate(860 18)\">\n        <path fill=\"var(--lantern)\" d=\"M0 -12 L3.5 -3.7 L12 -3.7 L5.2 1.6 L7.6 10 L0 5 L-7.6 10 L-5.2 1.6 L-12 -3.7 L-3.5 -3.7Z\"/>\n      </g>\n      <!-- hiker marker -->\n      <g class=\"hiker\" id=\"hiker\">\n        <circle r=\"9\" fill=\"var(--ember)\" stroke=\"var(--snow)\" stroke-width=\"3\"/>\n      </g>\n    </svg>\n    <div class=\"trail-meta\">\n      <span>Trail to the summit</span>\n      <span id=\"pct\"><strong>0%</strong> of the way there</span>\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  const root = document.getElementById('xmas');\n  const $ = id => document.getElementById(id);\n  const pad = n => String(n).padStart(2,'0');\n\n  // The \"season\" climb starts Oct 1 and summits Dec 25 (local time).\n  function targets(now){\n    let y = now.getFullYear();\n    const xmasStart = new Date(y, 11, 25);\n    const xmasEnd   = new Date(y, 11, 26);\n    if (now >= xmasEnd) y += 1;\n    return {\n      target: new Date(y, 11, 25),\n      start:  new Date(y, 9, 1),\n      isChristmas: now >= xmasStart && now < xmasEnd\n    };\n  }\n\n  const path = $('path'), hiker = $('hiker');\n  const len = path.getTotalLength();\n\n  function tick(){\n    const now = new Date();\n    const t = targets(now);\n    root.classList.toggle('is-christmas', t.isChristmas);\n\n    if (t.isChristmas){\n      placeHiker(1); $('pct').innerHTML = '<strong>Summit reached</strong>';\n      $('sub').textContent = 'It’s December 25';\n      return;\n    }\n\n    let diff = Math.max(0, t.target - now);\n    const d = Math.floor(diff / 864e5); diff -= d * 864e5;\n    const h = Math.floor(diff / 36e5);  diff -= h * 36e5;\n    const m = Math.floor(diff / 6e4);   diff -= m * 6e4;\n    const s = Math.floor(diff / 1e3);\n\n    $('d').textContent = d;\n    $('h').textContent = pad(h);\n    $('m').textContent = pad(m);\n    $('s').textContent = pad(s);\n    root.querySelector('.unit.days .lbl').textContent = d === 1 ? 'day' : 'days';\n    $('sub').textContent = 'Until December 25, ' + t.target.getFullYear();\n\n    const p = Math.min(1, Math.max(0, (now - t.start) / (t.target - t.start)));\n    placeHiker(p);\n    $('pct').innerHTML = now < t.start\n      ? 'The climb starts October 1'\n      : '<strong>' + Math.round(p*100) + '%</strong> of the way there';\n  }\n\n  function placeHiker(p){\n    const pt = path.getPointAtLength(len * p);\n    hiker.setAttribute('transform', 'translate(' + pt.x + ' ' + (pt.y - 4) + ')');\n  }\n\n  tick();\n  setInterval(tick, 1000);\n\n  // Gentle snowfall\n  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const cv = root.querySelector('canvas.snow');\n  if (reduce || !cv.getContext) return;\n  const ctx = cv.getContext('2d');\n  let W, H, flakes = [];\n  function size(){\n    const r = root.getBoundingClientRect(), dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = r.width; H = r.height;\n    cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr,0,0,dpr,0,0);\n    const count = Math.round(W / 9);\n    flakes = Array.from({length: count}, () => ({\n      x: Math.random()*W, y: Math.random()*H,\n      r: Math.random()*1.8 + .6, v: Math.random()*.5 + .25, drift: Math.random()*.6 - .3,\n      o: Math.random()*.5 + .35\n    }));\n  }\n  function draw(){\n    ctx.clearRect(0,0,W,H);\n    for (const f of flakes){\n      f.y += f.v; f.x += f.drift;\n      if (f.y > H) { f.y = -4; f.x = Math.random()*W; }\n      if (f.x > W) f.x = 0; if (f.x < 0) f.x = W;\n      ctx.globalAlpha = f.o; ctx.fillStyle = '#fff';\n      ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI*2); ctx.fill();\n    }\n    requestAnimationFrame(draw);\n  }\n  new ResizeObserver(size).observe(root);\n  size(); draw();\n})();\n</script>\n</body>\n</html>\n"
}